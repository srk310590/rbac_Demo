# Base URL of the Keycloak realm (issuer). Must match the `iss` claim in tokens.
KEYCLOAK_ISSUER=http://localhost:8080/realms/rbac-demo

# Must match the client ID configured in Keycloak (see keycloak/setup_realm.py)
KEYCLOAK_AUDIENCE=rbac-demo-app

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173
