# Keycloak realm issuer (base URL for authorize/token/logout endpoints)
VITE_KEYCLOAK_ISSUER=http://localhost:8080/realms/rbac-demo

# Public SPA client ID configured in Keycloak (see keycloak/setup_realm.py)
VITE_KEYCLOAK_CLIENT_ID=rbac-demo-app

# Where Keycloak should redirect back to after login (handled in main.js)
VITE_REDIRECT_URI=http://localhost:5173/

# Where to send API requests
VITE_API_BASE_URL=http://localhost:8000
